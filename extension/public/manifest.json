{
  "manifest_version": 3,
  "name": "WebPilot AI",
  "version": "1.0.0",
  "description": "AI-powered assistant for the web.",

  "action": {
    "default_popup": "index.html"
  },

  "permissions": [
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://localhost:5000/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}